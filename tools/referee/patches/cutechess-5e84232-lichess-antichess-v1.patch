+bool AntiBoard::winPossible(Side side) const
+{
+	if (side.isNull() || isInsufficientMaterial())
+		return false;
+
+	return side == sideToMove()
+		? !playerHasInsufficientMaterial()
+		: !opponentHasInsufficientMaterial();
+}
+
+bool AntiBoard::automaticDraw() const
+{
+	return isInsufficientMaterial()
+		|| reversibleMoveCount() >= 100
+		|| repeatCount() >= 4;
+}
+
+bool AntiBoard::mustCapture()
+{
+	const QVector<Move> moves = legalMoves();
+	for (const Move& move : moves)
+		if (captureType(move) != Piece::NoPiece)
+			return true;
+	return false;
+}
+
+bool AntiBoard::opponentHasInsufficientMaterial() const
+{
+	bool allOnSameColour = false;
+	return justOneKnightEach(&allOnSameColour) && allOnSameColour;
+}
+
+bool AntiBoard::playerHasInsufficientMaterial() const
+{
+	bool allOnSameColour = false;
+	return justOneKnightEach(&allOnSameColour) && !allOnSameColour;
+}
+
+bool AntiBoard::justOneKnightEach(bool* allOnSameColour) const
+{
+	int knightCount[2] = { 0, 0 };
+	Square::Color occupiedColour = Square::NoColor;
+	bool sameColour = true;
+
+	for (int i = 0; i < arraySize(); ++i)
+	{
+		const Piece piece = pieceAt(i);
+		if (!piece.isValid())
+			continue;
+		if (piece.type() != Knight)
+			return false;
+
+		const int sideIndex = piece.side() == Side::White ? 0 : 1;
+		++knightCount[sideIndex];
+
+		const Square::Color colour = chessSquare(i).color();
+		if (occupiedColour == Square::NoColor)
+			occupiedColour = colour;
+		else if (colour != occupiedColour)
+			sameColour = false;
+	}
+
+	if (knightCount[0] != 1 || knightCount[1] != 1)
+		return false;
+	if (allOnSameColour != nullptr)
+		*allOnSameColour = sameColour;
+	return true;
+}
+
+bool AntiBoard::isInsufficientMaterial() const
+{
+	bool bishopFound[2] = { false, false };
+	Square::Color bishopColour[2] = { Square::NoColor, Square::NoColor };
+
+	for (int i = 0; i < arraySize(); ++i)
+	{
+		const Piece piece = pieceAt(i);
+		if (!piece.isValid())
+			continue;
+		if (piece.type() != Bishop && piece.type() != Pawn)
+			return false;
+		if (piece.type() == Bishop)
+		{
+			const int sideIndex = piece.side() == Side::White ? 0 : 1;
+			const Square::Color colour = chessSquare(i).color();
+			if (bishopFound[sideIndex] && bishopColour[sideIndex] != colour)
+				return false;
+			bishopFound[sideIndex] = true;
+			bishopColour[sideIndex] = colour;
+		}
+	}
+
+	if (!bishopFound[0] || !bishopFound[1]
+	||  bishopColour[0] == bishopColour[1])
+		return false;
+
+	const int epSquare = enpassantSquare();
+	for (int i = 0; i < arraySize(); ++i)
+	{
+		const Piece piece = pieceAt(i);
+		if (!piece.isValid() || piece.type() != Pawn)
+			continue;
+
+		const Square square = chessSquare(i);
+		const int sideIndex = piece.side() == Side::White ? 0 : 1;
+		const Square::Color oppositeBishopColour = bishopColour[1 - sideIndex];
+		if (square.color() == oppositeBishopColour)
+			return false;
+
+		const int rankStep = piece.side() == Side::White ? 1 : -1;
+		const Square forward(square.file(), square.rank() + rankStep);
+		if (!isValidSquare(forward)
+		||  pieceAt(squareIndex(forward)).type() != Pawn)
+			return false;
+
+		for (int fileStep : { -1, 1 })
+		{
+			const Square target(square.file() + fileStep,
+					    square.rank() + rankStep);
+			if (!isValidSquare(target))
+				continue;
+			const int targetIndex = squareIndex(target);
+			if (pieceAt(targetIndex).side() == piece.side().opposite()
+			||  (piece.side() == sideToMove() && targetIndex == epSquare))
+				return false;
+		}
+	}
+
+	return true;
+}
+
 } // namespace Chess
