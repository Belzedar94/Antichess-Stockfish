+bool AntiBoard::parseCastlingRights(QChar c)
+{
+	/*
+	 * LICHESS_ANTICHESS_V1 accepts syntactically valid FEN castling text at
+	 * the input boundary but strips all rights from the canonical position.
+	 */
+	c = c.toLower();
+	return c == 'k' || c == 'q' || (c >= 'a' && c <= 'h');
