diff --git a/projects/lib/tests/antichessprofile/antichess_profile_probe.cpp b/projects/lib/tests/antichessprofile/antichess_profile_probe.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..095d1177953da93f629a135b2a512e0bc06305b5
--- /dev/null
+++ b/projects/lib/tests/antichessprofile/antichess_profile_probe.cpp
@@ -0,0 +1,131 @@
+#include <algorithm>
+#include <memory>
+
+#include <QCoreApplication>
+#include <QStringList>
+#include <QTextStream>
+
+#include <board/antiboard.h>
+#include <board/boardfactory.h>
+
+
+namespace {
+
+QString boolText(bool value)
+{
+	return value ? "1" : "0";
+}
+
+QString sideText(Chess::Side side)
+{
+	if (side == Chess::Side::White)
+		return "white";
+	if (side == Chess::Side::Black)
+		return "black";
+	return "none";
+}
+
+}
+
+
+int main(int argc, char* argv[])
+{
+	QCoreApplication app(argc, argv);
+	QTextStream out(stdout);
+	const QStringList arguments = app.arguments();
+	if (arguments.size() < 2)
+	{
+		out << "referee-error missing-fen\n";
+		return 2;
+	}
+
+	std::unique_ptr<Chess::Board> board(Chess::BoardFactory::create("antichess"));
+	if (board == nullptr)
+	{
+		out << "referee-error missing-antichess-board\n";
+		return 3;
+	}
+	if (!board->setFenString(arguments.at(1)))
+	{
+		out << "referee-error invalid-fen\n";
+		return 4;
+	}
+
+	for (int i = 2; i < arguments.size(); ++i)
+	{
+		const Chess::Move move = board->moveFromString(arguments.at(i));
+		if (move.isNull())
+		{
+			out << "referee-error illegal-move " << arguments.at(i) << '\n';
+			return 5;
+		}
+		board->makeMove(move);
+	}
+
+	auto* antichess = dynamic_cast<Chess::AntiBoard*>(board.get());
+	if (antichess == nullptr)
+	{
+		out << "referee-error wrong-board-type\n";
+		return 6;
+	}
+
+	QStringList legal;
+	QStringList san;
+	QStringList notation;
+	const QVector<Chess::Move> moves = board->legalMoves();
+	for (const Chess::Move& move : moves)
+	{
+		const QString uci = board->moveString(move, Chess::Board::LongAlgebraic);
+		const QString moveSan = board->moveString(move, Chess::Board::StandardAlgebraic);
+		legal << uci;
+		san << moveSan;
+		notation << uci + '=' + moveSan;
+	}
+	legal.sort(Qt::CaseSensitive);
+	san.sort(Qt::CaseSensitive);
+	notation.sort(Qt::CaseSensitive);
+
+	const bool variantEnd = moves.isEmpty();
+	const bool automaticDraw = antichess->automaticDraw();
+	const Chess::Result result = board->result();
+	QString status = "none";
+	if (variantEnd)
+		status = "variant_end";
+	else if (automaticDraw)
+		status = "draw";
+
+	const QStringList fenParts = board->fenString().split(' ');
+	const QString effectiveEp = fenParts.size() >= 4 && fenParts.at(3) != "-"
+		? fenParts.at(3)
+		: "none";
+
+	out << "referee-info profile=LICHESS_ANTICHESS_V1"
+	    << "|fen=" << board->fenString()
+	    << "|legal=" << legal.join(',')
+	    << "|san=" << san.join(',')
+	    << "|notation=" << notation.join(',')
+	    << "|end=" << boolText(variantEnd || automaticDraw)
+	    << "|variant_end=" << boolText(variantEnd)
+	    << "|automatic_draw=" << boolText(automaticDraw)
+	    << "|threefold=" << boolText(board->repeatCount() >= 2)
+	    << "|fivefold=" << boolText(board->repeatCount() >= 4)
+	    << "|status=" << status
+	    << "|winner=" << (variantEnd ? sideText(board->sideToMove()) : "none")
+	    << "|check=0"
+	    << "|must_capture=" << boolText(antichess->mustCapture())
+	    << "|player_insufficient="
+	    << boolText(antichess->playerHasInsufficientMaterial())
+	    << "|opponent_insufficient="
+	    << boolText(antichess->opponentHasInsufficientMaterial())
+	    << "|halfmove_clock=" << board->reversibleMoveCount()
+	    << "|effective_ep=" << effectiveEp
+	    << "|side_to_move=" << sideText(board->sideToMove())
+	    << "|white_win_possible=" << boolText(board->winPossible(Chess::Side::White))
+	    << "|black_win_possible=" << boolText(board->winPossible(Chess::Side::Black))
+	    << "|board_result="
+	    << (result.isNone() ? "none" : result.isDraw() ? "draw" : "win")
+	    << "|board_result_winner=" << sideText(result.winner())
+	    << "|board_result_reason=" << result.description()
+	    << '\n';
+	return 0;
+}

